{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/auth/login", "destination": "/api/index?route=auth/login" },
    { "source": "/api/auth/logout", "destination": "/api/index?route=auth/logout" },
    { "source": "/api/auth/me", "destination": "/api/index?route=auth/me" },
    { "source": "/api/admin/clients", "destination": "/api/index?route=admin/clients" },
    { "source": "/api/admin/destination", "destination": "/api/index?route=admin/destination" },
    { "source": "/api/admin/plate", "destination": "/api/index?route=admin/plate" },
    { "source": "/api/admin/plates", "destination": "/api/index?route=admin/plates" },
    { "source": "/api/client/destination", "destination": "/api/index?route=client/destination" },
    { "source": "/api/client/plates", "destination": "/api/index?route=client/plates" },
    { "source": "/api/public/activate", "destination": "/api/index?route=public/activate" },
    { "source": "/api/public/activation-login", "destination": "/api/index?route=public/activation-login" },
    { "source": "/api/public/plate", "destination": "/api/index?route=public/plate" },
    { "source": "/api/health", "destination": "/api/index?route=health" },
    { "source": "/api/resolve", "destination": "/api/index?route=resolve" },
    { "source": "/atv/:code", "destination": "/index.html" },
    { "source": "/q/:code", "destination": "/api/index?route=resolve&code=:code&source=qr" },
    { "source": "/n/:code", "destination": "/api/index?route=resolve&code=:code&source=nfc" },
    { "source": "/t/:code", "destination": "/api/index?route=resolve&code=:code&source=qr" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; media-src 'self' blob:" }
      ]
    }
  ]
}
